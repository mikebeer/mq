/* rxmq smoke test: publish one message to a queue and read it back */
options levelb
import rxfnsb
import rxmq

qname = "rxmq.smoke"

h = mqconnect("localhost", 5672, "guest", "guest", "/")
if h < 1 then do
  say "FAIL: connect:" mqerror(0)
  exit 1
end

if mqqueue(h, qname, "") <> 0 then do
  say "FAIL: declare:" mqerror(h)
  exit 1
end
call mqpurge h, qname

if mqpublish(h, "", qname, "hello rabbit", "correlation_id=abc reply_to=nowhere") <> 0 then do
  say "FAIL: publish:" mqerror(h)
  exit 1
end

if mqsubscribe(h, qname, 1) <> 0 then do
  say "FAIL: subscribe:" mqerror(h)
  exit 1
end

msg = .string[]
rc = mqreceive(h, 3000, msg)
if rc <> 0 then do
  say "FAIL: receive rc="rc mqerror(h)
  exit 1
end

if msg[1] <> "hello rabbit" then do
  say "FAIL: body [" || msg[1] || "]"
  exit 1
end
if msg[3] <> "nowhere" then do
  say "FAIL: reply_to [" || msg[3] || "]"
  exit 1
end
if msg[4] <> "abc" then do
  say "FAIL: correlation_id [" || msg[4] || "]"
  exit 1
end
if msg[6] <> qname then do
  say "FAIL: routing key [" || msg[6] || "]"
  exit 1
end

call mqack h, msg[2]

/* the queue is now empty: a short receive must time out with rc 1 */
rc = mqreceive(h, 300, msg)
if rc <> 1 then do
  say "FAIL: expected timeout, rc="rc
  exit 1
end

/* a broker side error (missing queue) must fail cleanly and leave the handle usable */
if mqpurge(h, "rxmq.no.such.queue") >= 0 then do
  say "FAIL: purge of a missing queue should fail"
  exit 1
end
if pos("404", mqerror(h)) = 0 then do
  say "FAIL: expected a 404 error text, got [" || mqerror(h) || "]"
  exit 1
end
if mqqueue(h, qname, "") <> 0 then do
  say "FAIL: handle unusable after broker error:" mqerror(h)
  exit 1
end

/* regression: a publish to a missing exchange is accepted (rc 0) and the broker then closes the
   channel; the next subscribe reports it and the handle must still be usable afterwards */
call mqpublish h, "rxmq.no.such.exchange", "k", "x", ""
call mqpublish h, "", qname, "settle", ""
if mqsubscribe(h, qname, 1) >= 0 then do
  say "FAIL: subscribe after a publish to a missing exchange should report the closed channel"
  exit 1
end
if mqsubscribe(h, qname, 1) <> 0 then do
  say "FAIL: handle unusable after the channel was closed:" mqerror(h)
  exit 1
end

/* publisher confirms: unroutable and refused publishes are reported, deliveries are not lost */
if mqconfirm(h) <> 0 then do
  say "FAIL: mqconfirm:" mqerror(h)
  exit 1
end
if mqpublish(h, "", qname, "confirmed", "") <> 0 then do
  say "FAIL: confirmed publish:" mqerror(h)
  exit 1
end
if mqpublish(h, "", "rxmq.no.such.queue", "x", "") <> -11 then do
  say "FAIL: publish to a missing queue should be -11, got [" || mqerror(h) || "]"
  exit 1
end
if mqpublish(h, "rxmq.no.such.exchange", "k", "x", "") <> -6 then do
  say "FAIL: publish to a missing exchange should be -6, got [" || mqerror(h) || "]"
  exit 1
end
if mqpublish(h, "", qname, "after the error", "") <> 0 then do
  say "FAIL: handle unusable after a refused publish:" mqerror(h)
  exit 1
end
/* a consumer on the same handle: deliveries that arrive while a confirm is awaited keep their order */
if mqsubscribe(h, qname, 0) <> 0 then do
  say "FAIL: subscribe:" mqerror(h)
  exit 1
end
do k = 1 to 5
  call mqpublish h, "", qname, "m" || k, ""
end
want = "confirmed|after the error|m1|m2|m3|m4|m5"
got = ""
do k = 1 to 7
  if mqreceive(h, 2000, msg) <> 0 then do
    say "FAIL: receive" k "of 7:" mqerror(h)
    exit 1
  end
  got = got || "|" || msg[1]
  call mqack h, msg[2]
end
if substr(got, 2) <> want then do
  say "FAIL: order of deliveries [" || substr(got, 2) || "]"
  exit 1
end

call mqdelete h, qname
call mqdisconnect h
say "PASS: rxmq smoke"
exit 0
